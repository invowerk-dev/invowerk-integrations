{
  "url": "/v1/generate",
  "method": "POST",
  "qs": {
    "format": "{{ifempty(parameters.format, undefined)}}"
  },
  "type": "json",
  "body": {
    "syntax": "{{ifempty(parameters.syntax, undefined)}}",
    "flavor": "{{ifempty(parameters.flavor, undefined)}}",
    "invoice_number": "{{parameters.invoice_number}}",
    "issue_date": "{{parameters.issue_date}}",
    "currency": "{{ifempty(parameters.currency, undefined)}}",
    "invoice_type_code": "{{ifempty(parameters.invoice_type_code, undefined)}}",
    "buyer_reference": "{{ifempty(parameters.buyer_reference, undefined)}}",
    "due_date": "{{ifempty(parameters.due_date, undefined)}}",
    "payment_iban": "{{ifempty(parameters.payment_iban, undefined)}}",
    "payment_terms": "{{ifempty(parameters.payment_terms, undefined)}}",
    "notes": "{{ifempty(parameters.notes, undefined)}}",
    "delivery_date": "{{ifempty(parameters.delivery_date, undefined)}}",
    "delivery_period_start": "{{ifempty(parameters.delivery_period_start, undefined)}}",
    "delivery_period_end": "{{ifempty(parameters.delivery_period_end, undefined)}}",
    "deliver_to": "{{ifempty(parameters.deliver_to, undefined)}}",
    "preceding_invoices": "{{ifempty(parameters.preceding_invoices, undefined)}}",
    "seller": "{{parameters.seller}}",
    "buyer": "{{parameters.buyer}}",
    "lines": "{{parameters.lines}}",
    "tax_breakdown": "{{parameters.tax_breakdown}}",
    "totals": "{{parameters.totals}}"
  },
  "response": {
    "type": {
      "*": "text",
      "400-599": "json"
    },
    "output": {
      "text": "{{body}}",
      "content_type": "{{headers.`content-type`}}"
    }
  }
}
