[
  {
    "name": "format",
    "label": "Format",
    "required": false,
    "type": "text",
    "help": "'json' returns {xml, syntax, flavor, self_validation}; omitted returns raw application/xml."
  },
  {
    "name": "syntax",
    "label": "Syntax",
    "required": false,
    "type": "select",
    "options": [
      {
        "label": "cii",
        "value": "cii"
      },
      {
        "label": "ubl",
        "value": "ubl"
      }
    ],
    "help": "XML syntax of the invoice: 'ubl' or 'cii'.",
    "default": "ubl"
  },
  {
    "name": "flavor",
    "label": "Flavor",
    "required": false,
    "type": "select",
    "options": [
      {
        "label": "en16931",
        "value": "en16931"
      },
      {
        "label": "xrechnung",
        "value": "xrechnung"
      }
    ],
    "help": "Rule set: 'en16931' (plain EN 16931) or 'xrechnung' (German rules).",
    "default": "en16931"
  },
  {
    "name": "invoice_number",
    "label": "Invoice number",
    "required": true,
    "type": "text",
    "help": "Invoice number (BT-1)."
  },
  {
    "name": "issue_date",
    "label": "Issue date",
    "required": true,
    "type": "text",
    "help": "Issue date, 'YYYY-MM-DD' (BT-2)."
  },
  {
    "name": "currency",
    "label": "Currency",
    "required": false,
    "type": "text",
    "help": "Currency code, ISO 4217, e.g. 'EUR' (BT-5).",
    "default": "EUR"
  },
  {
    "name": "invoice_type_code",
    "label": "Invoice type code",
    "required": false,
    "type": "text",
    "help": "Invoice type code from UNTDID 1001 (BT-3): '380' commercial invoice, '326' partial invoice, '381' credit note (syntax 'cii' only), '384' corrected invoice, '389' self-billed invoice, '875'/'876'/'877' partial, partial final and final construction invoice.",
    "default": "380"
  },
  {
    "name": "buyer_reference",
    "label": "Buyer reference",
    "required": false,
    "type": "text",
    "help": "Buyer reference, in Germany often the Leitweg-ID (BT-10). Required for flavor 'xrechnung' (BR-DE-15), optional for plain EN 16931."
  },
  {
    "name": "due_date",
    "label": "Due date",
    "required": false,
    "type": "text",
    "help": "Payment due date, 'YYYY-MM-DD' (BT-9)."
  },
  {
    "name": "payment_iban",
    "label": "Payment iban",
    "required": false,
    "type": "text",
    "help": "IBAN of the payee account for a bank transfer (BT-84). Without it the invoice carries no payment instructions (BG-16). Required for flavor 'xrechnung' (BR-DE-1)."
  },
  {
    "name": "payment_terms",
    "label": "Payment terms",
    "required": false,
    "type": "text",
    "help": "Payment terms as free text (BT-20)."
  },
  {
    "name": "notes",
    "label": "Notes",
    "required": false,
    "type": "json",
    "help": "Free-text notes on the invoice as a whole, one entry per note (BT-22). (JSON)"
  },
  {
    "name": "delivery_date",
    "label": "Delivery date",
    "required": false,
    "type": "text",
    "help": "Actual delivery date, 'YYYY-MM-DD' (BT-72). Defaults to the issue date unless a delivery period is given."
  },
  {
    "name": "delivery_period_start",
    "label": "Delivery period start",
    "required": false,
    "type": "text",
    "help": "Start of the invoicing period, 'YYYY-MM-DD' (BT-73, BG-14), e.g. the period a service covers."
  },
  {
    "name": "delivery_period_end",
    "label": "Delivery period end",
    "required": false,
    "type": "text",
    "help": "End of the invoicing period, 'YYYY-MM-DD' (BT-74, BG-14). Not before the start (BR-29)."
  },
  {
    "name": "deliver_to",
    "label": "Deliver to",
    "required": false,
    "type": "json",
    "help": "Deliver-to address (BG-15): where the goods go or the service is performed. Needed for VAT category 'K', intra-community supply (BT-80, BR-IC-12). (JSON)"
  },
  {
    "name": "preceding_invoices",
    "label": "Preceding invoices",
    "required": false,
    "type": "json",
    "help": "Earlier invoices this invoice refers to (BG-3), e.g. the invoice a corrected invoice (384) replaces. Syntax 'cii' carries at most one. (JSON)"
  },
  {
    "name": "seller",
    "label": "Seller",
    "required": true,
    "type": "json",
    "help": "The seller (BG-4). (JSON)"
  },
  {
    "name": "buyer",
    "label": "Buyer",
    "required": true,
    "type": "json",
    "help": "The buyer (BG-7). (JSON)"
  },
  {
    "name": "lines",
    "label": "Lines",
    "required": true,
    "type": "json",
    "help": "One or more invoice lines (BG-25). (JSON)"
  },
  {
    "name": "tax_breakdown",
    "label": "Tax breakdown",
    "required": true,
    "type": "json",
    "help": "One or more VAT breakdowns, one per VAT category and rate (BG-23). (JSON)"
  },
  {
    "name": "totals",
    "label": "Totals",
    "required": true,
    "type": "json",
    "help": "The document totals (BG-22). (JSON)"
  }
]
